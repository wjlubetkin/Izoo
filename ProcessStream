"""
Chimp Face Detection + Recognition Pipeline with YOLOv8
Modified for video file processing with temporal aggregation
"""

from __future__ import annotations

import cv2
import numpy as np
import tensorflow as tf
from pathlib import Path
from typing import List, Tuple, Optional, Dict
import matplotlib.pyplot as plt
from ultralytics import YOLO
import warnings
from collections import defaultdict, Counter
import pandas as pd
warnings.filterwarnings('ignore')

# Configure TensorFlow GPU settings
gpus = tf.config.experimental.list_physical_devices('GPU')
if gpus:
    try:
        for gpu in gpus:
            tf.config.experimental.set_memory_growth(gpu, True)
    except RuntimeError as e:
        print(f"GPU configuration error: {e}")

# ----------------------------- CONFIGURATION ---------------------------------
# YOLOv8 Model Settings
YOLO_MODEL_PATH = Path("best.pt")
YOLO_CONF_THRESHOLD = 0.25
YOLO_IMG_SIZE = 640

# ConvNeXt Model Settings  
IMG_SIZE = (224, 224)
CONVNEXT_MODEL_PATH = Path("convnext_finetuned_labelsmooth.keras")
CLASS_NAMES_TXT = Path("convnext_finetuned_labelsmooth.classes.txt")
TOP_K = 3

# Temporal aggregation settings
TIME_WINDOW = 5.0  # seconds - adjust this to change window length
CONFIDENCE_THRESHOLD = 0.5  # minimum confidence to count a prediction

# Manual color mapping (add custom colors here)
IDENTITY_COLORS = {
    'Cathy': 'green',
    # Add more identity-color mappings as needed
     'Arthur': 'blue',
     'Lucy'  : 'red',
     'Sue'   : 'purple',
     'Evelyne': 'orange',
     'Unknown': 'grey',
    
}
# -----------------------------------------------------------------------------

class ChimpFaceVideoPipeline:
    def __init__(self):
        # Initialize YOLOv8 model
        print("Loading YOLOv8 model...")
        self.yolo_model = YOLO(str(YOLO_MODEL_PATH))
        
        # Load ConvNeXt model with error handling
        print("Loading ConvNeXt model...")
        try:
            self.convnext_model = tf.keras.models.load_model(CONVNEXT_MODEL_PATH, compile=False)
        except Exception as e:
            print(f"GPU loading failed: {e}")
            print("Attempting to load model on CPU...")
            with tf.device('/CPU:0'):
                self.convnext_model = tf.keras.models.load_model(CONVNEXT_MODEL_PATH, compile=False)
        
        self.num_classes = self.convnext_model.output_shape[-1]
        self.class_names = self._load_class_names()
        
        # Storage for temporal analysis
        self.frame_predictions = []  # List of (timestamp, predictions) tuples
        self.window_predictions = []  # List of (window_start, window_end, identity) tuples
        
    def _load_class_names(self) -> List[str]:
        """Load class names from file or generate defaults."""
        if CLASS_NAMES_TXT.exists():
            names = [line.strip() for line in CLASS_NAMES_TXT.read_text().splitlines() if line.strip()]
            if len(names) != self.num_classes:
                raise ValueError(f"Class count mismatch: {len(names)} vs {self.num_classes}")
            return names
        return [f"chimp_{i}" for i in range(self.num_classes)]
    
    def detect_faces_yolo(self, image: np.ndarray) -> List[Dict]:
        """Detect faces using YOLOv8 OBB model."""
        results = self.yolo_model.predict(
            source=image,
            imgsz=YOLO_IMG_SIZE,
            conf=YOLO_CONF_THRESHOLD,
            verbose=False,
            stream=False
        )
        
        detections = []
        if results and len(results) > 0:
            result = results[0]
            
            # Handle OBB detections
            if hasattr(result, 'obb') and result.obb is not None:
                boxes = result.obb.xyxy.cpu().numpy() if hasattr(result.obb, 'xyxy') else []
                confs = result.obb.conf.cpu().numpy() if hasattr(result.obb, 'conf') else []
                
                for i, (box, conf) in enumerate(zip(boxes, confs)):
                    x1, y1, x2, y2 = map(int, box)
                    detections.append({
                        'bbox': (x1, y1, x2-x1, y2-y1),
                        'confidence': float(conf),
                        'obb_box': box
                    })
            
            # Fallback to regular bounding boxes
            elif hasattr(result, 'boxes') and result.boxes is not None:
                boxes = result.boxes.xyxy.cpu().numpy()
                confs = result.boxes.conf.cpu().numpy()
                
                for i, (box, conf) in enumerate(zip(boxes, confs)):
                    x1, y1, x2, y2 = map(int, box)
                    detections.append({
                        'bbox': (x1, y1, x2-x1, y2-y1),
                        'confidence': float(conf),
                        'obb_box': None
                    })
        
        return detections
    
    def extract_face_crops(self, image: np.ndarray, detections: List[Dict]) -> List[np.ndarray]:
        """Extract and resize face crops for model input."""
        crops = []
        for det in detections:
            x, y, w, h = det['bbox']
            
            # Add padding
            padding = 0.1
            pad_x = int(w * padding)
            pad_y = int(h * padding)
            
            x1 = max(0, x - pad_x)
            y1 = max(0, y - pad_y)
            x2 = min(image.shape[1], x + w + pad_x)
            y2 = min(image.shape[0], y + h + pad_y)
            
            crop = image[y1:y2, x1:x2]
            crop_resized = cv2.resize(crop, IMG_SIZE)
            crops.append(crop_resized)
            
        return crops
    
    def preprocess_for_convnext(self, crops: List[np.ndarray]) -> np.ndarray:
        """Preprocess face crops for ConvNeXt model."""
        if not crops:
            return np.array([])
        
        processed = np.array(crops, dtype=np.float32)
        return processed
    
    def recognize_faces(self, face_crops: List[np.ndarray]) -> List[List[Tuple[str, float]]]:
        """Run ConvNeXt inference on face crops."""
        if not face_crops:
            return []
        
        input_batch = self.preprocess_for_convnext(face_crops)
        
        try:
            predictions = self.convnext_model.predict(input_batch, verbose=0)
        except Exception as e:
            print(f"Inference error: {e}")
            with tf.device('/CPU:0'):
                predictions = self.convnext_model.predict(input_batch, verbose=0)
        
        top_k = min(TOP_K, self.num_classes)
        rank = np.argsort(-predictions, axis=1)[:, :top_k]
        
        results = []
        for i in range(len(face_crops)):
            preds = [(self.class_names[idx], float(predictions[i, idx])) for idx in rank[i]]
            results.append(preds)
        
        return results
    
    def aggregate_predictions_in_window(self, predictions: List[Tuple[float, List[Tuple[str, float]]]]) -> str:
        """
        Aggregate predictions within a time window using majority voting.
        Only count predictions above confidence threshold.
        """
        vote_counts = Counter()
        
        for timestamp, frame_preds in predictions:
            for preds_list in frame_preds:
                if preds_list:  # If there are predictions for this face
                    # Get the top prediction
                    best_class, best_conf = preds_list[0]
                    if best_conf >= CONFIDENCE_THRESHOLD:
                        vote_counts[best_class] += 1
        
        if vote_counts:
            # Return the class with most votes
            return vote_counts.most_common(1)[0][0]
        else:
            return "Unknown"
    
    def process_video(self, video_path: str, save_sample_frames: bool = False):
        """Process entire video file with temporal aggregation."""
        cap = cv2.VideoCapture(video_path)
        
        if not cap.isOpened():
            raise ValueError(f"Failed to open video: {video_path}")
        
        # Get video properties
        fps = cap.get(cv2.CAP_PROP_FPS)
        total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
        video_duration = total_frames / fps
        
        print(f"Video properties:")
        print(f"  FPS: {fps}")
        print(f"  Total frames: {total_frames}")
        print(f"  Duration: {video_duration:.2f} seconds")
        print(f"  Time window: {TIME_WINDOW} seconds")
        
        # Clear previous results
        self.frame_predictions = []
        self.window_predictions = []
        
        frame_count = 0
        current_window_start = 0.0
        current_window_predictions = []
        
        print("\nProcessing video...")
        
        while True:
            ret, frame = cap.read()
            if not ret:
                break
            
            timestamp = frame_count / fps
            
            # Process frame
            detections = self.detect_faces_yolo(frame)
            predictions = []
            
            if detections:
                face_crops = self.extract_face_crops(frame, detections)
                predictions = self.recognize_faces(face_crops)
            
            # Store frame predictions with timestamp
            if predictions:
                self.frame_predictions.append((timestamp, predictions))
                current_window_predictions.append((timestamp, predictions))
            
            # Check if we've completed a time window
            if timestamp - current_window_start >= TIME_WINDOW:
                # Aggregate predictions for this window
                if current_window_predictions:
                    window_identity = self.aggregate_predictions_in_window(current_window_predictions)
                    self.window_predictions.append(
                        (current_window_start, current_window_start + TIME_WINDOW, window_identity)
                    )
                
                # Move to next window
                current_window_start += TIME_WINDOW
                current_window_predictions = []
            
            frame_count += 1
            
            # Progress update
            if frame_count % 30 == 0:
                progress = (frame_count / total_frames) * 100
                print(f"  Progress: {progress:.1f}% ({frame_count}/{total_frames} frames)")
        
        # Process final window if it has data
        if current_window_predictions:
            window_identity = self.aggregate_predictions_in_window(current_window_predictions)
            self.window_predictions.append(
                (current_window_start, timestamp, window_identity)
            )
        
        cap.release()
        
        print(f"\nProcessing complete!")
        print(f"  Total frames processed: {frame_count}")
        print(f"  Total time windows: {len(self.window_predictions)}")
        
        return self.window_predictions
    
    def plot_cumulative_votes(self, save_path: Optional[str] = None):
        """Create a visualization of cumulative votes over time."""
        if not self.window_predictions:
            print("No predictions to plot!")
            return
        
        # Prepare data for plotting
        fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 10), 
                                       gridspec_kw={'height_ratios': [3, 1]})
        
        # Top plot: Cumulative votes over time
        # Define color function with manual override option
        def get_identity_color(name):
            """Get color for an identity - manual mapping or consistent auto-generated."""
            if name in IDENTITY_COLORS:
                return IDENTITY_COLORS[name]
            # Fallback to hash-based color
            hash_value = hash(name)
            color_index = abs(hash_value) % 20
            return plt.cm.tab20(color_index / 20.0)
        
        # Count votes per identity across all windows
        identity_votes = defaultdict(list)
        time_points = []
        
        cumulative_counts = defaultdict(int)
        
        for window_start, window_end, identity in self.window_predictions:
            window_center = (window_start + window_end) / 2
            time_points.append(window_center)
            
            cumulative_counts[identity] += 1
            
            for id_name in self.class_names:
                identity_votes[id_name].append(cumulative_counts[id_name])
        
        # Plot cumulative votes
        for identity, votes in identity_votes.items():
            if max(votes) > 0:  # Only plot identities that received votes
                ax1.plot(time_points, votes, marker='o', label=identity, 
                        linewidth=2, color=get_identity_color(identity))
        
        ax1.set_xlabel('Time (seconds)')
        ax1.set_ylabel('Cumulative Votes')
        ax1.set_title('Cumulative Identity Votes Over Time')
        ax1.legend()
        ax1.grid(True, alpha=0.3)
        
        # Bottom plot: Identity timeline
        # Create color map using manual colors when available
        def get_identity_color(name):
            """Get color for an identity - manual mapping or consistent auto-generated."""
            if name in IDENTITY_COLORS:
                return IDENTITY_COLORS[name]
            # Fallback to hash-based color
            hash_value = hash(name)
            color_index = abs(hash_value) % 20
            return plt.cm.tab20(color_index / 20.0)
        
        unique_identities = list(set([pred[2] for pred in self.window_predictions]))
        identity_colors = {identity: get_identity_color(identity) for identity in unique_identities}
        
        # Plot time windows
        for window_start, window_end, identity in self.window_predictions:
            ax2.barh(0, window_end - window_start, left=window_start, 
                    height=0.8, color=identity_colors[identity], 
                    edgecolor='black', linewidth=1)
            
            # Add text label in the middle of each window (vertically oriented)
            window_center = (window_start + window_end) / 2
            ax2.text(window_center, 0, identity, 
                    ha='center', va='center', fontsize=8, 
                    rotation=90,  # Rotate text 90 degrees
                    bbox=dict(boxstyle='round,pad=0.3', facecolor='white', alpha=0.7))
        
        ax2.set_xlabel('Time (seconds)')
        ax2.set_ylim(-0.5, 0.5)
        ax2.set_yticks([])
        ax2.set_title('Identity Timeline (Time Windows)')
        ax2.grid(True, axis='x', alpha=0.3)
        
        plt.tight_layout()
        
        if save_path:
            plt.savefig(save_path, dpi=300, bbox_inches='tight')
            print(f"Plot saved to: {save_path}")
        
        plt.show()
    
    def get_summary_statistics(self) -> pd.DataFrame:
        """Generate summary statistics of the video analysis."""
        if not self.window_predictions:
            return pd.DataFrame()
        
        # Count occurrences of each identity
        identity_counts = Counter([pred[2] for pred in self.window_predictions])
        
        # Calculate time spent for each identity
        identity_time = defaultdict(float)
        for window_start, window_end, identity in self.window_predictions:
            identity_time[identity] += (window_end - window_start)
        
        # Create summary dataframe
        summary_data = []
        for identity in identity_counts:
            summary_data.append({
                'Identity': identity,
                'Window Count': identity_counts[identity],
                'Total Time (s)': identity_time[identity],
                'Percentage': (identity_time[identity] / sum(identity_time.values())) * 100
            })
        
        df = pd.DataFrame(summary_data)
        df = df.sort_values('Total Time (s)', ascending=False)
        
        return df

# Example usage
def analyze_video(video_path: str, time_window: float = 5.0, confidence_threshold: float = 0.5):
    """
    Analyze a video file with the chimp face recognition pipeline.
    
    Args:
        video_path: Path to the video file
        time_window: Length of time windows in seconds
        confidence_threshold: Minimum confidence for predictions to count
    """
    global TIME_WINDOW, CONFIDENCE_THRESHOLD
    TIME_WINDOW = time_window
    CONFIDENCE_THRESHOLD = confidence_threshold
    
    # Initialize pipeline
    pipeline = ChimpFaceVideoPipeline()
    
    # Process video
    window_predictions = pipeline.process_video(video_path)
    
    # Generate visualizations
    pipeline.plot_cumulative_votes(save_path="cumulative_votes.png")
    
    # Get summary statistics
    summary = pipeline.get_summary_statistics()
    print("\n=== SUMMARY STATISTICS ===")
    print(summary.to_string(index=False))
    
    return pipeline, window_predictions, summary

