# ----------------------------- CONFIGURATION ---------------------------------
# YOLOv8 Model Settings
YOLO_MODEL_PATH = Path("chimp_face_yolo8_obb/exp2/weights/best.pt")
YOLO_CONF_THRESHOLD = 0.25
YOLO_IMG_SIZE = 640

# ConvNeXt Model Settings  
IMG_SIZE = (224, 224)
CONVNEXT_MODEL_PATH = Path("convnext_finetuned_labelsmooth.keras")
CLASS_NAMES_TXT = Path("convnext_finetuned_labelsmooth.classes.txt")
TOP_K = 3

# Streaming Settings
STREAM_SOURCE = 0  # 0 for webcam, or URL for IP camera/RTSP stream
DISPLAY_FPS = True
SAVE_DETECTIONS = False  # Save detected face crops
OUTPUT_DIR = Path("./streaming_detections")

# Create output directory if saving detections
if SAVE_DETECTIONS:
    OUTPUT_DIR.mkdir(exist_ok=True)
# -----------------------------------------------------------------------------

class ChimpFaceStreamingPipeline:
    def __init__(self):
        # Initialize YOLOv8 model
        print("Loading YOLOv8 model...")
        self.yolo_model = YOLO(str(YOLO_MODEL_PATH))
        
        # Load ConvNeXt model with error handling
        print("Loading ConvNeXt model...")
        try:
            # Try loading with GPU support
            self.convnext_model = tf.keras.models.load_model(CONVNEXT_MODEL_PATH, compile=False)
        except Exception as e:
            print(f"GPU loading failed: {e}")
            print("Attempting to load model on CPU...")
            with tf.device('/CPU:0'):
                self.convnext_model = tf.keras.models.load_model(CONVNEXT_MODEL_PATH, compile=False)
        
        self.num_classes = self.convnext_model.output_shape[-1]
        self.class_names = self._load_class_names()
        
        # Frame counter for FPS calculation
        self.frame_count = 0
        self.detection_count = 0
        
    def _load_class_names(self) -> List[str]:
        """Load class names from file or generate defaults."""
        if CLASS_NAMES_TXT.exists():
            names = [line.strip() for line in CLASS_NAMES_TXT.read_text().splitlines() if line.strip()]
            if len(names) != self.num_classes:
                raise ValueError(f"Class count mismatch: {len(names)} vs {self.num_classes}")
            return names
        return [f"chimp_{i}" for i in range(self.num_classes)]
    
    def detect_faces_yolo(self, image: np.ndarray) -> List[Dict]:
        """
        Detect faces using YOLOv8 OBB model.
        Returns list of detections with bounding boxes and confidence scores.
        """
        # Run YOLOv8 inference
        results = self.yolo_model.predict(
            source=image,
            imgsz=YOLO_IMG_SIZE,
            conf=YOLO_CONF_THRESHOLD,
            verbose=False,
            stream=False
        )
        
        detections = []
        if results and len(results) > 0:
            result = results[0]
            
            # Handle OBB (Oriented Bounding Box) detections
            if hasattr(result, 'obb') and result.obb is not None:
                boxes = result.obb.xyxy.cpu().numpy() if hasattr(result.obb, 'xyxy') else []
                confs = result.obb.conf.cpu().numpy() if hasattr(result.obb, 'conf') else []
                
                for i, (box, conf) in enumerate(zip(boxes, confs)):
                    x1, y1, x2, y2 = map(int, box)
                    detections.append({
                        'bbox': (x1, y1, x2-x1, y2-y1),  # (x, y, width, height)
                        'confidence': float(conf),
                        'obb_box': box  # Keep original OBB data
                    })
            
            # Fallback to regular bounding boxes if OBB not available
            elif hasattr(result, 'boxes') and result.boxes is not None:
                boxes = result.boxes.xyxy.cpu().numpy()
                confs = result.boxes.conf.cpu().numpy()
                
                for i, (box, conf) in enumerate(zip(boxes, confs)):
                    x1, y1, x2, y2 = map(int, box)
                    detections.append({
                        'bbox': (x1, y1, x2-x1, y2-y1),
                        'confidence': float(conf),
                        'obb_box': None
                    })
        
        return detections
    
    def extract_face_crops(self, image: np.ndarray, detections: List[Dict]) -> List[np.ndarray]:
        """Extract and resize face crops for model input."""
        crops = []
        for det in detections:
            x, y, w, h = det['bbox']
            
            # Add some padding around the face
            padding = 0.1  # 10% padding
            pad_x = int(w * padding)
            pad_y = int(h * padding)
            
            # Expand bounding box with padding
            x1 = max(0, x - pad_x)
            y1 = max(0, y - pad_y)
            x2 = min(image.shape[1], x + w + pad_x)
            y2 = min(image.shape[0], y + h + pad_y)
            
            # Extract crop
            crop = image[y1:y2, x1:x2]
            
            # Resize to model input size
            crop_resized = cv2.resize(crop, IMG_SIZE)
            crops.append(crop_resized)
            
        return crops
    
    def preprocess_for_convnext(self, crops: List[np.ndarray]) -> np.ndarray:
        """Preprocess face crops for ConvNeXt model."""
        if not crops:
            return np.array([])
        
        # Convert to float32 and keep in 0-255 range
        processed = np.array(crops, dtype=np.float32)
        return processed
    
    def recognize_faces(self, face_crops: List[np.ndarray]) -> List[List[Tuple[str, float]]]:
        """Run ConvNeXt inference on face crops."""
        if not face_crops:
            return []
        
        # Preprocess crops
        input_batch = self.preprocess_for_convnext(face_crops)
        
        try:
            # Run inference
            predictions = self.convnext_model.predict(input_batch, verbose=0)
        except Exception as e:
            print(f"Inference error: {e}")
            # Fallback to CPU inference
            with tf.device('/CPU:0'):
                predictions = self.convnext_model.predict(input_batch, verbose=0)
        
        # Get top-k predictions for each face
        top_k = min(TOP_K, self.num_classes)
        rank = np.argsort(-predictions, axis=1)[:, :top_k]
        
        results = []
        for i in range(len(face_crops)):
            preds = [(self.class_names[idx], float(predictions[i, idx])) for idx in rank[i]]
            results.append(preds)
        
        return results
    
    def draw_results_on_frame(self, frame: np.ndarray, detections: List[Dict], 
                             predictions: List[List[Tuple[str, float]]]) -> np.ndarray:
        """Draw bounding boxes and predictions on the frame."""
        annotated_frame = frame.copy()
        
        for i, (det, preds) in enumerate(zip(detections, predictions)):
            x, y, w, h = det['bbox']
            conf = det['confidence']
            
            # Draw bounding box
            cv2.rectangle(annotated_frame, (x, y), (x + w, y + h), (0, 255, 0), 2)
            
            # Prepare label
            if preds:
                best_class, best_prob = preds[0]
                label = f"{best_class} ({best_prob:.1%}) | YOLO: {conf:.1%}"
            else:
                label = f"Face {i+1} | YOLO: {conf:.1%}"
            
            # Draw label background
            label_size, _ = cv2.getTextSize(label, cv2.FONT_HERSHEY_SIMPLEX, 0.5, 1)
            cv2.rectangle(annotated_frame, (x, y - 20), (x + label_size[0], y), (0, 255, 0), -1)
            
            # Draw label text
            cv2.putText(annotated_frame, label, (x, y - 5), 
                       cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 0), 1)
        
        return annotated_frame
    
    def process_stream(self, source=None):
        """Process video stream with face detection and recognition."""
        # Use provided source or default
        stream_source = source if source is not None else STREAM_SOURCE
        
        # Open video stream
        print(f"Opening video stream: {stream_source}")
        cap = cv2.VideoCapture(stream_source)
        
        if not cap.isOpened():
            raise ValueError(f"Failed to open video stream: {stream_source}")
        
        # Get stream properties
        fps = int(cap.get(cv2.CAP_PROP_FPS))
        if fps == 0:
            fps = 30  # Default FPS if not available
        
        print("Starting stream processing... Press 'q' to quit")
        print("Press 's' to save current detections")
        
        frame_time = cv2.getTickCount()
        
        try:
            while True:
                ret, frame = cap.read()
                if not ret:
                    print("Failed to read frame or end of stream")
                    break
                
                self.frame_count += 1
                
                # Detect faces with YOLOv8
                detections = self.detect_faces_yolo(frame)
                
                # Extract face crops and run recognition if faces detected
                predictions = []
                if detections:
                    face_crops = self.extract_face_crops(frame, detections)
                    predictions = self.recognize_faces(face_crops)
                    self.detection_count += len(detections)
                
                # Draw results on frame
                annotated_frame = self.draw_results_on_frame(frame, detections, predictions)
                
                # Calculate and display FPS
                if DISPLAY_FPS:
                    current_time = cv2.getTickCount()
                    fps_calc = cv2.getTickFrequency() / (current_time - frame_time)
                    frame_time = current_time
                    
                    fps_text = f"FPS: {fps_calc:.1f} | Faces: {len(detections)}"
                    cv2.putText(annotated_frame, fps_text, (10, 30),
                               cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
                
                # Display frame
                cv2.imshow("Chimp Face Detection Stream", annotated_frame)
                
                # Handle keyboard input
                key = cv2.waitKey(1) & 0xFF
                if key == ord('q'):
                    break
                elif key == ord('s') and SAVE_DETECTIONS and detections:
                    # Save detected faces
                    timestamp = cv2.getTickCount()
                    for i, (det, crop) in enumerate(zip(detections, face_crops)):
                        filename = f"face_{timestamp}_{i}.jpg"
                        cv2.imwrite(str(OUTPUT_DIR / filename), crop)
                    print(f"Saved {len(detections)} face(s)")
                
        except KeyboardInterrupt:
            print("\nStream interrupted by user")
        
        finally:
            # Cleanup
            cap.release()
            cv2.destroyAllWindows()
            
            # Print summary
            print(f"\n=== STREAM SUMMARY ===")
            print(f"Total frames processed: {self.frame_count}")
            print(f"Total faces detected: {self.detection_count}")
            if self.frame_count > 0:
                print(f"Average faces per frame: {self.detection_count/self.frame_count:.2f}")

# Example usage functions
def stream_from_webcam():
    """Stream from default webcam."""
    pipeline = ChimpFaceStreamingPipeline()
    pipeline.process_stream(0)

def stream_from_ip_camera(url: str):
    """Stream from IP camera or RTSP stream."""
    pipeline = ChimpFaceStreamingPipeline()
    pipeline.process_stream(url)

def stream_from_video_file(video_path: str):
    """Process a video file as a stream."""
    pipeline = ChimpFaceStreamingPipeline()
    pipeline.process_stream(video_path)

# Main execution
if __name__ == "__main__":
    # Initialize pipeline
    pipeline = ChimpFaceStreamingPipeline()
    
    # Start streaming from default source
    pipeline.process_stream()
