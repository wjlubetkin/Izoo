"""
Chimp Face Detection + Recognition Pipeline with YOLOv8
Combines YOLOv8 OBB face detection with ConvNeXt facial recognition
Supports streaming video input
"""

from __future__ import annotations

import cv2
import numpy as np
import tensorflow as tf
from pathlib import Path
from typing import List, Tuple, Optional, Dict
import matplotlib.pyplot as plt
import matplotlib.patches as patches
from ultralytics import YOLO
import warnings
warnings.filterwarnings('ignore')

# Configure TensorFlow GPU settings
gpus = tf.config.experimental.list_physical_devices('GPU')
if gpus:
    try:
        # Method 1: Allow memory growth
        for gpu in gpus:
            tf.config.experimental.set_memory_growth(gpu, True)
    except RuntimeError as e:
        print(f"GPU configuration error: {e}")

# Alternative: Limit GPU memory usage
# tf.config.experimental.set_virtual_device_configuration(
#     gpus[0],
#     [tf.config.experimental.VirtualDeviceConfiguration(memory_limit=2048)]
